generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["ops"]
}

model User {
  id                          String           @id @default(cuid())
  email                       String           @unique
  name                        String           @default("")
  passwordHash                String?
  role                        String           @default("EMPLOYEE")
  status                      String           @default("ACTIVE")
  phone                       String?
  managerId                   String?
  manager                     User?            @relation("SupervisorEmployees", fields: [managerId], references: [id], onDelete: SetNull)
  managedEmployees            User[]           @relation("SupervisorEmployees")
  adminApproverId             String?
  adminApprover               User?            @relation("EmployeeAdminApproval", fields: [adminApproverId], references: [id], onDelete: SetNull)
  adminApprovedEmployees      User[]           @relation("EmployeeAdminApproval")
  funderId                    String?
  funder                      User?            @relation("FunderSupervisors", fields: [funderId], references: [id], onDelete: SetNull)
  supervisors                 User[]           @relation("FunderSupervisors")
  supervisor                  String?
  accountType                 String           @default("EMPLOYEE")
  department                  String?
  bank                        String?
  accountName                 String?
  accountNumber               String?
  fundingBankName             String?
  fundingAccountHolderName    String?
  fundingAccountNumber        String?
  payoutBankName              String?
  payoutAccountHolderName     String?
  payoutAccountNumber         String?
  refundBankName              String?
  refundAccountHolderName     String?
  refundAccountNumber         String?
  createdAt                   DateTime         @default(now())
  adminApprovedAt             DateTime?
  updatedAt                   DateTime         @updatedAt
  work                        WorkSubmission[]
  payments                    PaymentRequest[]
  payoutRequests              PayoutRequest[]  @relation("EmployeePayoutRequests")
  reviewedPayoutRequests      PayoutRequest[]  @relation("AdminPayoutReviews")
  supervisedWork              WorkSubmission[] @relation("SupervisorWork")
  supervisedPayments          PaymentRequest[] @relation("SupervisorPayments")
  fundingRequestsAsEmployee   FundingRequest[] @relation("FundingRequestEmployee")
  fundingRequestsAsFunder     FundingRequest[] @relation("FundingRequestFunder")
  fundingRequestsAsSupervisor FundingRequest[] @relation("FundingRequestSupervisor")
  refundRequestsAsEmployee    RefundRequest[]  @relation("RefundRequestEmployee")
  refundRequestsAsFunder      RefundRequest[]  @relation("RefundRequestFunder")
  fundingReportsAsEmployee    FundingReport[]  @relation("FundingReportEmployee")
  fundingReportsAsFunder      FundingReport[]  @relation("FundingReportFunder")

  @@index([accountType, status])
  @@index([accountType, createdAt])
  @@schema("ops")
}

model WorkSubmission {
  id               String          @id @default(cuid())
  accountName      String          @map("title")
  legacyDescription String         @map("description")
  accountCategory  String          @map("category")
  completedAt      DateTime
  amount           Int
  notes            String?
  status           String          @default("PENDING")
  submittedAt      DateTime        @default(now())
  approvedAt       DateTime?
  updatedAt        DateTime        @updatedAt
  employeeId       String
  employee         User            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  supervisorId     String?
  supervisor       User?           @relation("SupervisorWork", fields: [supervisorId], references: [id], onDelete: SetNull)
  fundingRequestId String?         @unique
  fundingRequest   FundingRequest? @relation(fields: [fundingRequestId], references: [id], onDelete: SetNull)
  payment          PaymentRequest?
  payoutRequestId  String?
  payoutRequest    PayoutRequest? @relation(fields: [payoutRequestId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([status])
  @@index([employeeId, status, payoutRequestId])
  @@index([approvedAt])
  @@schema("ops")
}

model FundingRequest {
  id              String          @id @default(cuid())
  employeeId      String
  employee        User            @relation("FundingRequestEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  funderId        String
  funder          User            @relation("FundingRequestFunder", fields: [funderId], references: [id], onDelete: Restrict)
  supervisorId    String
  supervisor      User            @relation("FundingRequestSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
  accountName     String?
  accountCategory String?
  amount          Int
  purpose         String?
  status          String          @default("PENDING_FUNDER_APPROVAL")
  requestedAt     DateTime        @default(now())
  lastStatusChangedAt DateTime?
  approvedAt      DateTime?
  completedAt     DateTime?
  work            WorkSubmission?
  refunds          RefundRequest[]
  reports          FundingReport[]

  @@index([employeeId, status, requestedAt])
  @@index([funderId, status, requestedAt])
  @@index([supervisorId, status, requestedAt])
  @@index([status, requestedAt])
  @@index([approvedAt])
  @@schema("ops")
}

model RefundRequest {
  id                String         @id @default(cuid())
  fundingRequestId  String
  fundingRequest    FundingRequest @relation(fields: [fundingRequestId], references: [id], onDelete: Restrict)
  employeeId        String
  employee          User           @relation("RefundRequestEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  funderId          String
  funder            User           @relation("RefundRequestFunder", fields: [funderId], references: [id], onDelete: Restrict)
  amount            Int
  status            String         @default("PENDING_FUNDER_APPROVAL")
  paymentReference  String?
  employeeConfirmedAt DateTime      @default(now())
  requestedAt       DateTime       @default(now())
  processedAt       DateTime?
  funderNote        String?

  @@index([employeeId, requestedAt])
  @@index([funderId, status, requestedAt])
  @@index([fundingRequestId, status])
  @@index([status, requestedAt])
  @@schema("ops")
}

model FundingReport {
  id               String         @id @default(cuid())
  fundingRequestId String
  fundingRequest   FundingRequest @relation(fields: [fundingRequestId], references: [id], onDelete: Restrict)
  employeeId       String
  employee         User           @relation("FundingReportEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  funderId         String
  funder           User           @relation("FundingReportFunder", fields: [funderId], references: [id], onDelete: Restrict)
  reason           String         @db.VarChar(2000)
  status           String         @default("PENDING_FUNDER_APPROVAL")
  requestedAt      DateTime       @default(now())
  processedAt      DateTime?
  funderNote        String?

  @@index([employeeId, requestedAt])
  @@index([funderId, status, requestedAt])
  @@index([fundingRequestId, requestedAt])
  @@index([status, requestedAt])
  @@schema("ops")
}

model PaymentRequest {
  id           String         @id @default(cuid())
  amount       Int
  status       String         @default("PENDING")
  notes        String?
  requestedAt  DateTime       @default(now())
  processedAt  DateTime?
  employeeId   String
  employee     User           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  supervisorId String?
  supervisor   User?          @relation("SupervisorPayments", fields: [supervisorId], references: [id], onDelete: SetNull)
  workId       String         @unique
  work         WorkSubmission @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@schema("ops")
}

model PayoutRequest {
  id                       String   @id @default(cuid())
  amount                   Int
  workCount                Int
  status                   String   @default("PENDING")
  requestedAt              DateTime @default(now())
  processedAt              DateTime?
  adminNote                String?
  employeeId               String
  employee                 User     @relation("EmployeePayoutRequests", fields: [employeeId], references: [id], onDelete: Restrict)
  employeeName             String
  employeeEmail            String
    employeePhone            String?
  payoutBankName           String
  payoutAccountHolderName   String
  payoutAccountNumber       String
  reviewerId               String?
  reviewer                 User?    @relation("AdminPayoutReviews", fields: [reviewerId], references: [id], onDelete: SetNull)
  works                    WorkSubmission[]

  @@index([employeeId, requestedAt])
  @@index([status, requestedAt])
  @@index([requestedAt])
  @@index([processedAt])
  @@schema("ops")
}
